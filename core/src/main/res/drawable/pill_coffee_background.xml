    android:shape="rectangle">
    <solid android:color="#80141620" />
    <corners android:radius="20dp" />
    <stroke
        android:width="1dp"
        android:color="#4DFFC107" />
    <padding
        android:left="14dp"
        android:top="8dp"
        android:right="14dp"
        android:bottom="8dp" />
</shape>
