<?xml version="1.0" encoding="utf-8"?>
<!-- Animated twin of ic_coffee.xml: the same Lucide "coffee" cup in the same amber (#FFC107),
     with its three static steam ticks replaced by three curling wisps that rise and fade out of
     the top of the viewport, each one a third of a cycle behind the last.

     The steam is doing two jobs, and the second one is why it is this long. The Lucide cup is a
     wide, short glyph - it fills only about half the viewport's height, where the chat bubble
     beside it in the footer fills nearly all of it. At identical button sizes that made the cup
     render visibly smaller and sit lower than its partner, so the pair did not read as a pair.
     Wisps that run from the rim up to y=3 give the cup composition the same vertical extent as
     the bubble (both now span roughly y3..y21), which balances the two without scaling the cup
     up - it cannot be scaled, as its handle already reaches x=22 and would clip the viewport.

     The first version's wisps were short enough to read as two stray apostrophes rather than as
     heat, which is the other half of the same fix.

     Self-contained on purpose: the vector and all six animators are inlined with AAPT inline
     resources (xmlns:aapt), so this one file is the whole drop-in - there is nothing to copy
     out of res/animator when the footer moves to another Layerbit app. Safe on API 26+. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">

    <aapt:attr name="android:drawable">
        <vector
            android:width="18dp"
            android:height="18dp"
            android:viewportWidth="24"
            android:viewportHeight="24">

            <!-- ic_coffee.xml's cup, at its exact coordinates. The earlier 1.5-unit downward
                 nudge is gone: the wisps now start at the rim instead of above it, so the cup
                 needs no headroom, and sitting at its true position puts it on the same optical
                 baseline as the chat bubble next to it. -->
            <group android:name="cup">

                <path
                    android:name="cupHandle"
                    android:pathData="M17,8 h1 a4,4 0 1 1 0,8 h-1"
                    android:fillColor="#00000000"
                    android:strokeColor="#FFC107"
                    android:strokeWidth="2"
                    android:strokeLineCap="round"
                    android:strokeLineJoin="round" />

                <path
                    android:name="cupBody"
                    android:pathData="M3,8 h14 v9 a4,4 0 0 1 -4,4 h-6 a4,4 0 0 1 -4,-4 Z"
                    android:fillColor="#00000000"
                    android:strokeColor="#FFC107"
                    android:strokeWidth="2"
                    android:strokeLineCap="round"
                    android:strokeLineJoin="round" />

            </group>

            <!-- Authored at strokeAlpha 0.7 so frame 0 is a complete, steaming cup: that is what
                 a device with "Remove animations" on will show, and it needs no fallback code. -->
            <group android:name="wispLeftGroup">
                <path
                    android:name="wispLeft"
                    android:pathData="M6.5,7.5 c-1.4,-1.7 1.4,-2.8 0,-4.5"
                    android:fillColor="#00000000"
                    android:strokeColor="#FFC107"
                    android:strokeWidth="1.7"
                    android:strokeAlpha="0.7"
                    android:strokeLineCap="round" />
            </group>

            <group android:name="wispMidGroup">
                <path
                    android:name="wispMid"
                    android:pathData="M10,7.5 c-1.5,-1.8 1.5,-3.0 0,-4.8"
                    android:fillColor="#00000000"
                    android:strokeColor="#FFC107"
                    android:strokeWidth="1.7"
                    android:strokeAlpha="0.7"
                    android:strokeLineCap="round" />
            </group>

            <group android:name="wispRightGroup">
                <path
                    android:name="wispRight"
                    android:pathData="M13.5,7.5 c-1.4,-1.7 1.4,-2.8 0,-4.5"
                    android:fillColor="#00000000"
                    android:strokeColor="#FFC107"
                    android:strokeWidth="1.7"
                    android:strokeAlpha="0.7"
                    android:strokeLineCap="round" />
            </group>

        </vector>
    </aapt:attr>

    <!-- Each wisp is two animators: the group rises, the path fades. They MUST share the same
         duration and startOffset - strokeAlpha hitting 0.0 at fraction 0 and 1 is the only
         thing hiding translateY restarting back to 0 at the top of each cycle.

         The rise is deliberately short (under 2 units) now that the wisps are long: these tops
         already sit near y=3, and a taller rise would shave the stroke flat against the top of
         the viewport instead of letting it taper. The motion reads from the fade, not the
         distance. -->

    <target android:name="wispLeftGroup">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="2600"
                android:startOffset="0"
                android:repeatCount="infinite"
                android:repeatMode="restart"
                android:propertyName="translateY"
                android:valueType="floatType"
                android:valueFrom="0.0"
                android:valueTo="-1.8"
                android:interpolator="@android:interpolator/linear" />
        </aapt:attr>
    </target>

    <target android:name="wispLeft">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="2600"
                android:startOffset="0"
                android:repeatCount="infinite"
                android:repeatMode="restart"
                android:interpolator="@android:interpolator/linear">
                <propertyValuesHolder
                    android:propertyName="strokeAlpha"
                    android:valueType="floatType">
                    <keyframe android:fraction="0.0" android:value="0.0" />
                    <keyframe android:fraction="0.22" android:value="0.9" />
                    <keyframe android:fraction="0.6" android:value="0.65" />
                    <keyframe android:fraction="1.0" android:value="0.0" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>

    <target android:name="wispMidGroup">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="2600"
                android:startOffset="870"
                android:repeatCount="infinite"
                android:repeatMode="restart"
                android:propertyName="translateY"
                android:valueType="floatType"
                android:valueFrom="0.0"
                android:valueTo="-1.5"
                android:interpolator="@android:interpolator/linear" />
        </aapt:attr>
    </target>

    <target android:name="wispMid">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="2600"
                android:startOffset="870"
                android:repeatCount="infinite"
                android:repeatMode="restart"
                android:interpolator="@android:interpolator/linear">
                <propertyValuesHolder
                    android:propertyName="strokeAlpha"
                    android:valueType="floatType">
                    <keyframe android:fraction="0.0" android:value="0.0" />
                    <keyframe android:fraction="0.22" android:value="0.95" />
                    <keyframe android:fraction="0.6" android:value="0.7" />
                    <keyframe android:fraction="1.0" android:value="0.0" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>

    <target android:name="wispRightGroup">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="2600"
                android:startOffset="1740"
                android:repeatCount="infinite"
                android:repeatMode="restart"
                android:propertyName="translateY"
                android:valueType="floatType"
                android:valueFrom="0.0"
                android:valueTo="-1.8"
                android:interpolator="@android:interpolator/linear" />
        </aapt:attr>
    </target>

    <target android:name="wispRight">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="2600"
                android:startOffset="1740"
                android:repeatCount="infinite"
                android:repeatMode="restart"
                android:interpolator="@android:interpolator/linear">
                <propertyValuesHolder
                    android:propertyName="strokeAlpha"
                    android:valueType="floatType">
                    <keyframe android:fraction="0.0" android:value="0.0" />
                    <keyframe android:fraction="0.22" android:value="0.85" />
                    <keyframe android:fraction="0.6" android:value="0.6" />
                    <keyframe android:fraction="1.0" android:value="0.0" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>

</animated-vector>
