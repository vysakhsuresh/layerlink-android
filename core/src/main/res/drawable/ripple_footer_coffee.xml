<?xml version="1.0" encoding="utf-8"?>
<!-- Press state for the footer's coffee action, which no longer has a pill border to light up.
     A borderless oval ripple keeps the button feeling like an object you pushed while leaving it
     with zero resting chrome, which is the whole point of the one-line footer. Tinted to the cup's
     own amber so the feedback belongs to that glyph rather than looking like a generic grey
     touch splash. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/brand_coffee_ripple">

    <item android:id="@android:id/mask">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>

</ripple>
