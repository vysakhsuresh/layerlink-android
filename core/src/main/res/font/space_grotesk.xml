<?xml version="1.0" encoding="utf-8"?>
<!-- Space Grotesk, the site's own typeface (layerbit.co.in, css/base.css + index.html Google
     Fonts link), bundled as a real asset (SIL Open Font License) rather than loaded over the
     network, with per-weight files so android:textStyle="bold" etc. picks the real bold face
     instead of a synthetic/faux-bold render of the regular one. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/space_grotesk_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/space_grotesk_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />
    <font
        android:font="@font/space_grotesk_medium"
        android:fontStyle="normal"
        android:fontWeight="500"
        app:font="@font/space_grotesk_medium"
        app:fontStyle="normal"
        app:fontWeight="500" />
    <font
        android:font="@font/space_grotesk_semibold"
        android:fontStyle="normal"
        android:fontWeight="600"
        app:font="@font/space_grotesk_semibold"
        app:fontStyle="normal"
        app:fontWeight="600" />
    <font
        android:font="@font/space_grotesk_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/space_grotesk_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />
</font-family>
