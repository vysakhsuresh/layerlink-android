<?xml version="1.0" encoding="utf-8"?>
<!-- Company-wide "Powered by Layerbit AI" footer + support actions, meant to be dropped into any
     app via <include layout="@layout/view_brand_footer" android:id="@+id/..." .../> with
     width/height/constraint attributes on the include tag itself (a real root view here, not
     <merge> - View Binding's merge-flattening does not work across module boundaries, so the
     including app accesses this layout's views via the generated ViewBrandFooterBinding
     nested under the include's own id, e.g. binding.brandFooterInclude.brandFooterRow).

     This used to be three stacked tiers: a 1dp full-bleed accent_main_dim rule, the brand mark,
     then two bordered text pills side by side. That hairline was the only full-bleed rule in an
     app whose every other boundary is a rounded card, so it read as window chrome rather than
     content - and inside a NestedScrollView it could scroll up into mid-content where it looked
     like a clipped card edge. Worse, two bold mirrored pills sitting under a quiet grey line and
     directly beneath an outlined Stop button made the last thing on the screen look like a
     decision the user owed somebody. So the rule is gone (26dp of top padding and the drop to
     12sp text_muted do the separating), and the pills are gone too: the footer is now ONE 48dp
     line - cup, signature, chat bubble - that reads as a calm sign-off and is ~33dp shorter than
     what it replaces.

     The two actions are icon-only on purpose, which is only honest because both glyphs move. The
     cup steams (three amber wisps rising and fading out of phase) so it reads as hot coffee rather
     than an abstract shape, and the bubble's three bars rise and settle like a typing indicator so
     it reads as "someone is there". Both labels survive for screen readers and for anyone who
     long-presses, via contentDescription plus android:tooltipText on the buttons themselves.

     The root is BrandFooterLayout rather than a plain ConstraintLayout because an
     AnimatedVectorDrawable set through android:src never starts by itself - something has to call
     start() on it, and it has to stop again whenever the footer goes off screen or the window is
     backgrounded. Owning that in the footer's own root keeps this a true self-contained include:
     the host app writes no animation code at all, and MainActivity's existing
     brandFooterInclude.root.isVisible = ... is already the trigger. Note that :app therefore needs
     :core on its compile classpath to inflate this layout, which it has.

     Deliberately no android:tint on either ImageButton: both drawables are two-tone (amber cup,
     cyan bubble with lighter #00F2FE bars) and a tint would collapse each of them to one colour. -->
<com.layerbit.core.brand.BrandFooterLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingTop="26dp"
    android:paddingEnd="16dp"
    android:paddingBottom="18dp">

    <!-- Chain head. Packed and centred, so the brand signature stays optically centred in the
         window and the two actions sit symmetrically either side of it. -->
    <ImageButton
        android:id="@+id/btnBuyCoffee"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/ripple_footer_coffee"
        android:contentDescription="@string/core_buy_coffee"
        android:padding="13dp"
        android:scaleType="fitCenter"
        android:src="@drawable/avd_coffee_steam"
        android:tooltipText="@string/core_buy_coffee"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/brandFooterRow"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Untouched content: the mark and the credit line are the one part of the old footer that
         was already right. It is wrap_content with constrainedWidth so that at large font scales
         the TEXT gives way (maxLines + ellipsize) and the two 48dp targets never shrink. -->
    <LinearLayout
        android:id="@+id/brandFooterRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:contentDescription="@string/core_powered_by"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnGetHelp"
        app:layout_constraintStart_toEndOf="@id/btnBuyCoffee"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_layerbit_mark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/core_powered_by"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Help goes on the right on purpose: it mirrors layerbit.co.in's own bottom-right chat FAB,
         it sits at the natural reading exit and under the right thumb, and of the two actions it
         is the one somebody might actually need in a hurry. -->
    <ImageButton
        android:id="@+id/btnGetHelp"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/ripple_footer_chat"
        android:contentDescription="@string/core_get_help"
        android:padding="13dp"
        android:scaleType="fitCenter"
        android:src="@drawable/avd_chat_live"
        android:tooltipText="@string/core_get_help"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/brandFooterRow"
        app:layout_constraintTop_toTopOf="parent" />

</com.layerbit.core.brand.BrandFooterLayout>
