<?xml version="1.0" encoding="utf-8"?>
<!-- Company-wide "Powered by Layerbit AI" footer + support links, meant to be dropped into any
     app via <include layout="@layout/view_brand_footer" android:id="@+id/..." .../> with
     width/height/constraint attributes on the include tag itself (a real root view here, not
     <merge> - View Binding's merge-flattening does not work across module boundaries, so the
     including app accesses this layout's views via the generated ViewBrandFooterBinding
     nested under the include's own id, e.g. binding.brandFooterInclude.brandFooterRow). -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <View
        android:id="@+id/brandFooterDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/accent_main_dim"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/brandFooterRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/brandFooterDivider">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/card_background"
            android:contentDescription="@string/core_powered_by"
            android:padding="4dp"
            android:src="@drawable/ic_layerbit_mark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/core_powered_by"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/brandSupportRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/brandFooterRow">

        <TextView
            android:id="@+id/btnGetHelp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:padding="8dp"
            android:text="@string/core_get_help"
            android:textColor="@color/accent_main"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="  ·  "
            android:textColor="@color/text_muted" />

        <TextView
            android:id="@+id/btnBuyCoffee"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:padding="8dp"
            android:text="@string/core_buy_coffee"
            android:textColor="@color/accent_main"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
