<?xml version="1.0" encoding="utf-8"?>
<!--
  Relay setup. Three fields and a Test button, because the failure this fixes was invisible: a
  relay whose credentials are rejected behaves exactly like a working one until a viewer on
  another network fails to connect - minutes later, on someone else's phone, with no error on
  either end. Test runs the real WebRTC ICE agent in relay-only mode (see RelayProbe), so a pass
  here means a broadcast started right now would have a relayed path.

  Styled with the same card_background/link_box_background/text_* tokens as the rest of the app,
  and shown through AlertDialog.setView() with a transparent window, exactly like
  dialog_get_help.xml - plain EditTexts rather than Material text fields so nothing inherits
  DayNight chrome into this fixed-dark UI.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_background"
    android:orientation="vertical"
    android:padding="22dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/relay_dialog_title"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:lineSpacingExtra="3dp"
        android:text="@string/relay_dialog_body"
        android:textColor="@color/text_muted"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/relayProviderHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lineSpacingExtra="3dp"
        android:text="@string/relay_dialog_provider"
        android:textColor="@color/accent_main"
        android:textSize="12.5sp" />

    <EditText
        android:id="@+id/relayHost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/link_box_background"
        android:hint="@string/relay_field_host"
        android:imeOptions="actionNext"
        android:importantForAutofill="no"
        android:inputType="textUri"
        android:padding="13dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:textSize="14sp"
        tools:text="relay1.expressturn.com" />

    <EditText
        android:id="@+id/relayUsername"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:background="@drawable/link_box_background"
        android:hint="@string/relay_field_username"
        android:imeOptions="actionNext"
        android:importantForAutofill="no"
        android:inputType="text"
        android:padding="13dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:textSize="14sp" />

    <!-- Deliberately not inputType="textPassword": this is a shared relay credential pasted
         from a provider's dashboard, not a login. It has to stay readable to be checked against
         the source, and masking it would only make a typo harder to find. -->
    <EditText
        android:id="@+id/relayPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:background="@drawable/link_box_background"
        android:hint="@string/relay_field_password"
        android:imeOptions="actionDone"
        android:importantForAutofill="no"
        android:inputType="text"
        android:padding="13dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:textSize="14sp"
        tools:ignore="TextFields" />

    <TextView
        android:id="@+id/relayTestResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:lineSpacingExtra="2dp"
        android:textSize="12.5sp"
        android:visibility="gone"
        tools:text="@string/relay_test_working"
        tools:visibility="visible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnRelayRemove"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            android:text="@string/relay_remove"
            android:textColor="@color/status_error_soft"
            android:textSize="13.5sp"
            android:visibility="gone"
            tools:ignore="RtlSymmetry"
            tools:visibility="visible" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnRelayTest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:padding="10dp"
            android:text="@string/relay_test"
            android:textColor="@color/text_primary"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnRelaySave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/action_row_background"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="18dp"
            android:paddingTop="11dp"
            android:paddingEnd="18dp"
            android:paddingBottom="11dp"
            android:text="@string/relay_save"
            android:textColor="@color/accent_main"
            android:textSize="13.5sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
