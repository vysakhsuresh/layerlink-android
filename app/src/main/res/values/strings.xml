    <string name="relay_dialog_title">Relay server</string>
    <string name="relay_dialog_body">A relay carries the video when the two phones can\'t reach each other directly — which is normal between countries and on most mobile networks. Without one, a share only works when both sides happen to sit on friendly networks.</string>
    <string name="relay_dialog_provider">Any TURN server works. A free one takes about a minute to create — expressturn.com, metered.ca or Cloudflare all give you a host, a username and a password to paste below.</string>
    <string name="relay_field_host">Host — e.g. relay1.expressturn.com</string>
