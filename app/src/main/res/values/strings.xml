    <string name="outcome_never_connected_title">Your viewer couldn\'t reach you</string>
    <string name="outcome_never_connected_body">A network between you blocked the connection. This happens most across countries and on some mobile networks.\n\nSwitching between Wi-Fi and mobile data often fixes it.</string>
    <!-- Shown instead of the above when the session knew it had no relay: that is the cause,
         and no amount of switching networks will fix it. -->
    <string name="outcome_no_relay_title">No relay, so no connection</string>
