<?xml version="1.0" encoding="utf-8"?>
<!-- The adaptive icon's background layer. This is deliberately the same token the app's own
     window background uses (@color/background_dark): on the Android 12+ splash screen the system
     draws this icon over windowSplashScreenBackground, so any other colour here shows up as a
     grey tile floating on the app's navy - which is exactly how it looked before. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:fillColor="@color/background_dark" android:pathData="M0,0h108v108h-108z" />
</vector>
