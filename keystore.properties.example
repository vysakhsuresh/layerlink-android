# Copy this file to "keystore.properties" (same directory) and fill in your real values.
# keystore.properties is git-ignored - it must NEVER be committed, since it holds the
# passwords protecting your app's signing key. Losing the .jks file itself (not just this
# file) means you can never publish an update to this app again under the same listing.
storeFile=/absolute/path/to/your-release-key.jks
storePassword=your-keystore-password
keyAlias=your-key-alias
keyPassword=your-key-password
